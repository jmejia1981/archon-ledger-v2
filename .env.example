# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Scheduler Configuration
SCHEDULER_SECRET_KEY=your-generated-secret-key-here

# Email Provider Configuration (choose one)

# Option 1: Resend (Recommended)
RESEND_API_KEY=

# Option 2: SendGrid
SENDGRID_API_KEY=

# Option 3: SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Supabase service role — SERVER ONLY.
# Bypasses row level security. Never prefix this NEXT_PUBLIC_ and never commit it.
# Used solely to reach plaid_items, which holds bank access tokens.
SUPABASE_SERVICE_ROLE_KEY=

# Plaid. PLAID_SECRET is server only; it must never be prefixed NEXT_PUBLIC_.
# PLAID_ENV is sandbox or production (Plaid retired the development environment).
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
